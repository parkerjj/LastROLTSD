ENVIRONMENT=local
BUILD_VERSION=dev
MAX_BODY_BYTES=524288

# UPLOAD_API_KEY is only used by local fixtures; never commit real keys.
UPLOAD_API_KEY=replace-with-local-key
UPLOAD_API_KEY_SHA256=replace-with-local-key-sha256
ADMIN_SECRET=replace-with-local-admin-secret
# Cursor HMAC secret; set a random value in staging/production with wrangler secret put.
CURSOR_SECRET=replace-with-local-cursor-secret
GUESTBOOK_RATE_SECRET=replace-with-at-least-32-character-secret

# Account authentication stays disabled until explicitly enabled locally. Generate
# four independent 32-byte base64 values in ignored .dev.vars; never use placeholders.
AUTH_ENABLED=false
AUTH_SITE_URL=http://localhost:5173
AUTH_PASSWORD_SECRET=
AUTH_PASSWORD_KEY_VERSION=1
AUTH_PASSWORD_PREVIOUS_KEY_VERSION=
AUTH_PASSWORD_PREVIOUS_SECRET=
AUTH_CSRF_SECRET=
AUTH_RATE_SECRET=
AUTH_MAIL_PAYLOAD_SECRET=
AUTH_MAIL_PAYLOAD_KEY_VERSION=1
AUTH_MAIL_PAYLOAD_PREVIOUS_KEY_VERSION=
AUTH_MAIL_PAYLOAD_PREVIOUS_SECRET=
AUTH_MAIL_DAILY_LIMIT=100
AUTH_MAIL_MONTHLY_LIMIT=3000
# Resend is optional for local login; configure only for fake/local testing or a
# deliberately authorized delivery setup. Do not send real player mail in tests.
RESEND_API_KEY=
MAIL_FROM="LTSD <no-reply@example.test>"
MAIL_REPLY_TO=



# Set this to the VPS MySQL 8 URL for local Worker development. Never commit a real URL.
MYSQL_URL=mysql://replace-user:replace-password@replace-host:3306/replace-database?ssl=true
# Optional Node integration-test target. Use a dedicated MySQL test database, never production.
MYSQL_TEST_URL=mysql://replace-user:replace-password@replace-host:3306/replace-test-database?ssl=true
# The real MySQL integration test stays skipped unless this is changed to 1 explicitly.
ALLOW_MYSQL_TEST_DESTRUCTIVE=0

# Afdian (爱发电) open API token for the sponsor page. Leave empty for local development;
# the endpoint then responds 503. In production it is injected from the GitHub production
# environment secret AFDIAN_TOKEN. Never commit a real token.
AFDIAN_TOKEN=
# Public creator user id. Optional: the Worker falls back to the built-in LTSD_RO value.
AFDIAN_USER_ID=

# Stripe Secret Key for the /sponsor honor roll merge. Leave empty to silently skip
# Stripe donors (honor roll degrades to Afdian-only). In production it is injected from
# the GitHub production environment secret STRIPE_SECRET_KEY via wrangler secret put.
# Never commit a real key (sk_live_... or sk_test_...).
STRIPE_SECRET_KEY=
# Optional: override the Stripe Payment Link donate URL. Defaults to the LTSD_RO built-in
# https://donate.stripe.com/3cI3cxa8B4Q0fY8ejM1RC00 when left empty.
STRIPE_DONATE_URL=
