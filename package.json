{
  "name": "lastroweb",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test:docs": "node scripts/check-docs.mjs",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "cf:config": "node scripts/render-wrangler-config.mjs",
    "cf:source-seed": "node scripts/render-source-seed.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250918.0",
    "@playwright/test": "^1.55.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.17.0",
    "hono": "^4.7.11",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "8.20.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wrangler": "^4.133.0"
  }
}
